FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copia package files del workspace (root + frontend)
COPY package.json package-lock.json ./
COPY apps/frontend/package.json apps/frontend/

# Crea placeholder per il workspace backend (serve a npm install)
RUN mkdir -p apps/backend && \
    echo '{"name":"@progetto/backend","version":"1.0.0","private":true}' > apps/backend/package.json && \
    mkdir -p packages

# Installa dipendenze
RUN npm ci --workspace=apps/frontend --include-workspace-root

# Copia sorgenti frontend
COPY apps/frontend/ apps/frontend/

EXPOSE 3000

CMD ["npm", "run", "dev", "-w", "apps/frontend"]
