FROM node:22-slim

# Argon2 richiede build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copia package files del workspace (root + backend)
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/

# Crea placeholder per il workspace frontend (serve a npm install)
RUN mkdir -p apps/frontend && \
    echo '{"name":"@progetto/frontend","version":"1.0.0","private":true}' > apps/frontend/package.json && \
    mkdir -p packages

# Installa dipendenze
RUN npm ci --workspace=apps/backend --include-workspace-root

# Copia sorgenti backend + prisma schema
COPY apps/backend/ apps/backend/

# Genera Prisma client
RUN cd apps/backend && npx prisma generate

EXPOSE 3333

CMD ["npm", "run", "start:dev", "-w", "apps/backend"]
