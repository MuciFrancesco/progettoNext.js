# EditorConfig helps maintain consistent coding styles for multiple developers

root = true

# All files
[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# TypeScript/JavaScript
[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = single

# Shell/Bash
[*.sh]
indent_size = 2
