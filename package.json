{
  "name": "progetto-nextjs",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test:unit": "npm run test:unit -w apps/frontend && npm test -w apps/backend",
    "test:unit:frontend": "npm run test:unit -w apps/frontend",
    "test:unit:backend": "npm test -w apps/backend",
    "test:e2e:backend": "npm run test:e2e -w apps/backend",
    "test:e2e:frontend": "npm run test:e2e -w apps/frontend",
    "test:e2e:frontend:gherkin": "npm run test:gherkin -w apps/frontend",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json}\"",
    "db:dev:up": "npm run db:dev:up -w apps/backend",
    "db:dev:restart": "npm run db:dev:restart -w apps/backend",
    "db:dev:migrate": "npm run db:dev:migrate -w apps/backend --",
    "db:seed:admin": "npm run db:seed:admin -w apps/backend",
    "db:seed:demo": "npm run db:seed:demo -w apps/backend",
    "backend:dev": "npm run start:dev -w apps/backend",
    "frontend:dev": "npm run dev -w apps/frontend",
    "e2e:stack": "concurrently -k -n backend,frontend \"npm run start:dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "dev:seed": "powershell -ExecutionPolicy Bypass -File scripts\\dev-seed.ps1",
    "dev:full": "powershell -ExecutionPolicy Bypass -File scripts\\dev-full.ps1",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts\\dev-stop.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@tailwindcss/postcss": "^4.2.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "formik": "^2.4.9"
  }
}
